# Kopieer naar .env en vul in. Zet .env NOOIT in git.

# Verplicht buiten development: lange willekeurige string, bijv.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Development: zet op 1 voor debug-modus en reloader (nooit in productie)
FLASK_DEBUG=1

# Database (standaard: SQLite in data/minder_drinken.db)
# DATABASE_URL=sqlite:////pad/naar/minder_drinken.db

# Naam en teksten in de UI
SITE_NAME=Fris
# SITE_TAGLINE=Houd je alcoholgebruik bij en werk in je eigen tempo aan minderen of stoppen.
CONTACT_EMAIL=contact@example.org

# Passkeys (WebAuthn). In productie: je domein en https-origin
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
# WEBAUTHN_RP_NAME=Fris

# Productie achter HTTPS
# SESSION_COOKIE_SECURE=true
# Aantal reverse proxies voor X-Forwarded-* (bijv. 1 achter nginx/Caddy)
# TRUSTED_PROXIES=1

# Rem op inlogpogingen
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=900

# E-mail (optioneel; zonder MAIL_SERVER worden mails naar de log geschreven)
# MAIL_SERVER=smtp.example.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@example.org
# MAIL_USE_TLS=true
